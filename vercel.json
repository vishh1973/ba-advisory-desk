{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/low-credit-reminders",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/docs/:path*",
      "destination": "/404.html"
    },
    {
      "source": "/supabase/:path*",
      "destination": "/404.html"
    },
    {
      "source": "/tools/:path*",
      "destination": "/404.html"
    },
    {
      "source": "/README.md",
      "destination": "/404.html"
    },
    {
      "source": "/DEPLOYMENT_GUIDE.md",
      "destination": "/404.html"
    },
    {
      "source": "/PROJECT_ISSUE_TRACKER.md",
      "destination": "/404.html"
    },
    {
      "source": "/.env.example",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://ydkehgqitnxmvqoicxwu.supabase.co wss://ydkehgqitnxmvqoicxwu.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
