# Stripe
# Production should stay on live keys (`sk_live_`/`rk_live_`) and the built-in live price IDs.
# Stripe test/sandbox QA should run in a separate Vercel Preview/Staging deployment with
# `STRIPE_SECRET_KEY=sk_test_...`, a test webhook secret, and explicit test price IDs below.
# The app intentionally refuses to fall back to live price IDs when a test Stripe key is active.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required for test/preview Stripe mode; production live mode uses the hardcoded live catalog.
